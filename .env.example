# 复制为 .env.local 后再填写。不要把 .env.local 发到群里或上传到 GitHub。
CLOUDBASE_ENV_ID=你的云开发环境ID
CLOUDBASE_REGION=ap-shanghai
CLOUDBASE_ADMIN_USERNAME=counselor
ADMIN_UID=辅导员云开发账号的UID
# 多校共站时可填单行 JSON；每所学校必须使用不同的 CloudBase 环境 ID。
# DORM_SCHOOLS_JSON={"school-a":{"name":"示例学校甲","envId":"环境A","adminUsername":"counselor-a"},"school-b":{"name":"示例学校乙","envId":"环境B","adminUsername":"counselor-b"}}
